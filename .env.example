# Copy to .env locally; never commit real credentials.
# Use an URL-safe random password (letters, digits, - and _), at least 32 chars.
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
ALLOWED_ORIGINS=https://your-internal-host.example
COOKIE_SECURE=true
# 邮件原文和单个上传附件的大小上限，单位 MiB。
MAX_UPLOAD_MIB=25
# For localhost-only HTTP smoke testing, explicitly set:
# ALLOWED_ORIGINS=http://127.0.0.1:8080
# COOKIE_SECURE=false
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=replace-with-a-fernet-key
