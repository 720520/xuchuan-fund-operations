# Legacy environment-only mailbox example. New mailboxes should be managed by an
# administrator in the web page; do not place new authorization codes here.
# Existing deployments may keep this file temporarily during migration.
# MAIL_CUSTODY_A_HOST=imap.example.com
# MAIL_CUSTODY_A_PORT=993
# MAIL_CUSTODY_A_TLS=ssl
# MAIL_CUSTODY_A_USER=operations@example.com
# MAIL_CUSTODY_A_PASSWORD=use-an-app-password
# MAIL_CUSTODY_A_OAUTH_TOKEN=alternative-to-password
# MAIL_CUSTODY_A_FOLDER=INBOX
# MAIL_CUSTODY_A_SEND_ID=false
